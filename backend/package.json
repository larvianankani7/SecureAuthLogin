    "@fastify/rate-limit": "^11.2.1",
    "@fastify/redis": "^9.0.1",
    "@supabase/supabase-js": "^2.117.3",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.1",
    "nodemailer": "^10.1.0",
    "postgres": "^3.4.9",
    "redis": "^6.3.0",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
